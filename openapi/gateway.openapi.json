{
  "components": {
    "schemas": {
      "AgentRequest": {
        "description": "Input to ``POST /v1/agent`` (Wave 7).",
        "example": {
          "max_steps": 4,
          "question": "summarise the README",
          "session_id": "user-42"
        },
        "properties": {
          "max_steps": {
            "anyOf": [
              {
                "maximum": 20.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-request override of the AGENT_MAX_STEPS budget.",
            "title": "Max Steps"
          },
          "question": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "If set, the agent loads the session's prior turns and persists the new pair.",
            "title": "Session Id"
          },
          "use_chat_history": {
            "default": true,
            "description": "If false, session_id is ignored (stateless turn).",
            "title": "Use Chat History",
            "type": "boolean"
          }
        },
        "required": [
          "question"
        ],
        "title": "AgentRequest",
        "type": "object"
      },
      "AgentResponse": {
        "description": "Result of ``POST /v1/agent`` (Wave 7).",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "route": {
            "description": "Final routing label (``kb`` or ``chitchat``).",
            "title": "Route",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "sources_used": {
            "default": 0,
            "minimum": 0.0,
            "title": "Sources Used",
            "type": "integer"
          },
          "steps_used": {
            "minimum": 0.0,
            "title": "Steps Used",
            "type": "integer"
          },
          "tool_calls": {
            "items": {
              "$ref": "#/components/schemas/AgentToolCallEntry"
            },
            "title": "Tool Calls",
            "type": "array"
          },
          "trace": {
            "description": "Ordered list of graph node visits for this invocation.",
            "items": {
              "type": "string"
            },
            "title": "Trace",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "route",
          "steps_used"
        ],
        "title": "AgentResponse",
        "type": "object"
      },
      "AgentToolCallEntry": {
        "description": "One tool invocation, suitable for inclusion in :class:`AgentResponse`.",
        "properties": {
          "duration_ms": {
            "minimum": 0.0,
            "title": "Duration Ms",
            "type": "number"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "input": {
            "additionalProperties": true,
            "title": "Input",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "output_summary": {
            "description": "Tool output reduced to a string for transport (e.g. retriever returns '<n> docs', calc returns the number, web_search returns '<n> hits'). Full payloads stay inside the agent state for tracing.",
            "title": "Output Summary",
            "type": "string"
          }
        },
        "required": [
          "name",
          "output_summary",
          "duration_ms"
        ],
        "title": "AgentToolCallEntry",
        "type": "object"
      },
      "DocumentDeleteResponse": {
        "description": "Result of ``DELETE /v1/documents/{doc_id}`` (Wave 4).",
        "properties": {
          "doc_id": {
            "title": "Doc Id",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "removed_chunks": {
            "minimum": 0.0,
            "title": "Removed Chunks",
            "type": "integer"
          }
        },
        "required": [
          "doc_id",
          "removed_chunks",
          "message"
        ],
        "title": "DocumentDeleteResponse",
        "type": "object"
      },
      "DocumentIngestRequest": {
        "example": {
          "chunk_overlap": 50,
          "chunk_size": 500,
          "content": "def foo():\n    return 42\n",
          "filename": "main.py",
          "mime_type": "text/x-python"
        },
        "properties": {
          "chunk_overlap": {
            "default": 50,
            "description": "Number of characters each chunk overlaps with its neighbour. Must be strictly less than chunk_size; the splitter enforces that.",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Chunk Overlap",
            "type": "integer"
          },
          "chunk_size": {
            "default": 500,
            "maximum": 10000.0,
            "minimum": 50.0,
            "title": "Chunk Size",
            "type": "integer"
          },
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "document_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Stable id for this document; generated if omitted.",
            "title": "Document Id"
          },
          "filename": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "mime_type": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional MIME type hint (e.g. text/x-python, text/markdown). When omitted the splitter falls back to detecting the language from the filename suffix and finally to a plain recursive character split.",
            "title": "Mime Type"
          },
          "replace_kb": {
            "default": false,
            "description": "If true, remove all existing knowledge before adding this document.",
            "title": "Replace Kb",
            "type": "boolean"
          }
        },
        "required": [
          "filename",
          "content"
        ],
        "title": "DocumentIngestRequest",
        "type": "object"
      },
      "DocumentIngestResponse": {
        "properties": {
          "document_id": {
            "description": "Id of the stored document (use for traceability)",
            "title": "Document Id",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "num_chunks": {
            "title": "Num Chunks",
            "type": "integer"
          }
        },
        "required": [
          "message",
          "num_chunks",
          "filename",
          "document_id"
        ],
        "title": "DocumentIngestResponse",
        "type": "object"
      },
      "DocumentListResponse": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentSummaryResponse"
            },
            "title": "Documents",
            "type": "array"
          },
          "total": {
            "description": "Number of distinct documents in the KB",
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "documents",
          "total"
        ],
        "title": "DocumentListResponse",
        "type": "object"
      },
      "DocumentSummaryResponse": {
        "description": "One document row in :class:`DocumentListResponse` (Wave 4).",
        "properties": {
          "chunk_count": {
            "minimum": 0.0,
            "title": "Chunk Count",
            "type": "integer"
          },
          "doc_id": {
            "title": "Doc Id",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "mime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mime"
          }
        },
        "required": [
          "doc_id",
          "filename",
          "chunk_count"
        ],
        "title": "DocumentSummaryResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "QueryRequest": {
        "example": {
          "question": "What does foo return?",
          "session_id": "user-42",
          "top_k": 5
        },
        "properties": {
          "question": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "If set, prior turns in this session are sent to the model and updated after each reply.",
            "title": "Session Id"
          },
          "top_k": {
            "default": 5,
            "description": "Number of KB chunks to merge into context",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          },
          "use_chat_history": {
            "default": true,
            "description": "If false, session_id is ignored (stateless turn).",
            "title": "Use Chat History",
            "type": "boolean"
          }
        },
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "type": "object"
      },
      "QueryResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "context_preview": {
            "description": "Short preview of merged retrieval context",
            "title": "Context Preview",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Echo when conversation state was used",
            "title": "Session Id"
          },
          "sources_used": {
            "default": 0,
            "description": "How many KB chunks were merged into context",
            "title": "Sources Used",
            "type": "integer"
          }
        },
        "required": [
          "answer",
          "context_preview"
        ],
        "title": "QueryResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "ready",
          "service"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "BFF orchestrating ingest and RAG microservices",
    "title": "sorakAi Gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root",
        "tags": [
          "ops"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/agent": {
      "post": {
        "operationId": "proxy_agent_v1_agent_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Proxy Agent",
        "tags": [
          "agent"
        ]
      }
    },
    "/v1/agent/stream": {
      "post": {
        "operationId": "proxy_agent_stream_v1_agent_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Proxy Agent Stream",
        "tags": [
          "agent"
        ]
      }
    },
    "/v1/documents": {
      "get": {
        "operationId": "proxy_list_documents_v1_documents_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Proxy List Documents",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "operationId": "proxy_ingest_v1_documents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentIngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentIngestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Proxy Ingest",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/documents/{doc_id}": {
      "delete": {
        "operationId": "proxy_delete_document_v1_documents__doc_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "doc_id",
            "required": true,
            "schema": {
              "title": "Doc Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDeleteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Proxy Delete Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/query": {
      "post": {
        "operationId": "proxy_query_v1_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Proxy Query",
        "tags": [
          "rag"
        ]
      }
    },
    "/v1/query/stream": {
      "post": {
        "operationId": "proxy_query_stream_v1_query_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Proxy Query Stream",
        "tags": [
          "rag"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Ingest pipeline",
      "name": "documents"
    },
    {
      "description": "Question answering",
      "name": "rag"
    },
    {
      "description": "Health and readiness",
      "name": "ops"
    },
    {
      "description": "Legacy /api/v1 -> /v1 redirects",
      "name": "compat"
    }
  ]
}
